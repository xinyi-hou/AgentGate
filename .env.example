# Credential precedence: AGENTGATE_* > SUB_* > PACKY_*.
AGENTGATE_LLM_BASE_URL=
AGENTGATE_LLM_API_KEY=
SUB_URL=
SUB_LLM_API=
PACKY_API_URL=https://www.packyapi.com/v1
PACKY_API_KEY_DEFAULT=
LLM_MODEL_DEFAULT=gpt-5.5
AGENTGATE_LLM_ENABLED=false
AGENTGATE_LLM_TIMEOUT=30
AGENTGATE_LLM_FAIL_CLOSED=false
AGENTGATE_SEMANTIC_CONFIDENCE_THRESHOLD=0.75
AGENTGATE_POLICY_BACKEND=builtin
AGENTGATE_OPA_URL=http://127.0.0.1:8181
AGENTGATE_AUDIT_PATH=.agentgate/audit.jsonl
