# Optional policy and state configuration for local experiments.
AGENTGATE_POLICY_PATH=
AGENTGATE_SESSION_TTL_SECONDS=3600
AGENTGATE_HISTORY_LIMIT=200
AGENTGATE_HISTORY_TTL_SECONDS=3600
AGENTGATE_LABEL_TTL_SECONDS=3600
AGENTGATE_APPROVAL_TTL_SECONDS=300
AGENTGATE_REDIS_URL=

# Auxiliary content evidence is observe-only unless sanitize is explicitly selected.
AGENTGATE_CONTENT_MODE=observe
AGENTGATE_RESEARCH_DEBUG=false

# Destination classification used by ToolSecurityEvent normalization.
AGENTGATE_INTERNAL_DOMAINS=corp.example,services.internal
AGENTGATE_TRUSTED_EXTERNAL_DOMAINS=partner.example

# Research audit output. Raw payload logging is disabled by default.
AGENTGATE_AUDIT_BACKEND=jsonl
AGENTGATE_AUDIT_PATH=.agentgate/security-audit.jsonl
AGENTGATE_UNSAFE_DEBUG_AUDIT_PAYLOADS=false
